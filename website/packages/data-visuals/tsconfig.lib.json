{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/lib",
    "outDir": "dist-types",
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/lib"],
  "exclude": ["src/lib/**/*.test.ts", "src/lib/**/*.test.tsx"]
}
