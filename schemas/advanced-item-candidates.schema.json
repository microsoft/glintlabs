{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exploratory SVD question-removal candidate shortlist",
  "type": "object",
  "required": ["config_sha256", "summary_sha256", "approved_for_sharing", "ranking_basis", "limitations", "protected_items_reviewed", "content_coverage_reviewed", "protected_items", "items"],
  "properties": {
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_for_sharing": {"const": true},
    "ranking_basis": {"type": "string", "minLength": 1, "maxLength": 2400, "pattern": "\\S"},
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"}
    },
    "protected_items_reviewed": {"type": "boolean"},
    "content_coverage_reviewed": {"type": "boolean"},
    "protected_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_request": {
      "type": "object",
      "required": ["reason", "requested_inputs"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S"},
        "requested_inputs": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"}
        }
      },
      "additionalProperties": false
    },
    "pair_leads": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["questions", "reason", "evidence_needed"],
        "properties": {
          "questions": {
            "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"},
          "evidence_needed": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"}
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["question", "reason", "evidence_needed"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "comparison_question": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"},
          "evidence_needed": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
