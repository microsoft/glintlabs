{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advanced centered SVD survey experiment",
  "type": "object",
  "required": ["schema_version", "source", "experiment"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {"$ref": "#/$defs/source"},
    "survey": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"},
        "invited_count": {"type": "integer", "minimum": 5},
        "respondent_column": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {"invited_count": ["respondent_column"]},
      "additionalProperties": false
    },
    "joins": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["source", "key", "columns", "eligibility_confirmed", "provenance_confirmed"],
        "properties": {
          "source": {"$ref": "#/$defs/source"},
          "key": {"type": "string", "minLength": 1},
          "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "eligibility_confirmed": {"const": true},
          "provenance_confirmed": {"const": true},
          "available_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "experiment": {
      "type": "object",
      "required": ["task", "features", "group", "seed", "min_group_size", "validation", "budget", "models", "metric", "components"],
      "properties": {
        "task": {"const": "svd"},
        "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "group": {"type": "string", "minLength": 1},
        "time": {"type": "string"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "split_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "min_group_size": {"type": "integer", "minimum": 5},
        "scale": {"type": "boolean"},
        "components": {"type": "integer", "minimum": 1},
        "metric": {"const": "reconstruction_rmse"},
        "utility_threshold": {"const": 0, "description": "Optional legacy placeholder; unused by SVD."},
        "models": {"type": "array", "maxItems": 0},
        "validation": {
          "type": "object",
          "required": ["kind", "folds", "holdout_fraction", "unseen_groups"],
          "properties": {
            "kind": {"enum": ["group", "time"]},
            "folds": {"type": "integer", "minimum": 2, "maximum": 10},
            "holdout_fraction": {"type": "number", "minimum": 0.1, "maximum": 0.4},
            "unseen_groups": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "required": ["threads", "max_trials", "max_rows", "max_seconds"],
          "properties": {
            "threads": {"type": "integer", "minimum": 1, "maximum": 8},
            "max_trials": {"type": "integer", "minimum": 1, "maximum": 50},
            "max_rows": {"type": "integer", "minimum": 30, "maximum": 200000},
            "max_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "source": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sheet": {"type": "string"},
        "attribute_sheet": {"type": "string"},
        "prepared": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
