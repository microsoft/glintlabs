{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advanced aggregate sharing manifest (not basic analysis-manifest.json)",
  "type": "object",
  "required": ["schema_version", "kind", "status", "config_sha256", "source_sha256", "provenance", "qa", "summary", "artifacts", "interpretation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "advanced-survey"},
    "status": {"enum": ["not_run", "completed", "failed", "cancelled"]},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {"type": "object"},
    "survey": {
      "type": "object",
      "required": ["name", "response_count", "feature_count", "invited_count", "response_rate"],
      "properties": {
        "name": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
        "response_count": {"type": ["integer", "null"], "minimum": 5},
        "feature_count": {"type": "integer", "minimum": 1},
        "invited_count": {"type": ["integer", "null"], "minimum": 5},
        "response_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "required": ["verdict", "repeatability", "limitations"],
      "properties": {
        "verdict": {"enum": ["Not ready", "Use with caveats", "Ready"]},
        "repeatability": {"enum": ["not_run", "passed", "failed"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "summary": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["path", "sha256", "classification"],
        "properties": {
          "path": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "classification": {"const": "aggregate-share"}
        },
        "additionalProperties": false
      }
    },
    "interpretation": {"type": "object"},
    "item_review": {"type": "object"},
    "item_candidates": {"type": "object"}
  },
  "additionalProperties": false
}
