{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound, analyst-reviewed survey question removal assessment",
  "type": "object",
  "required": ["config_sha256", "summary_sha256", "approved_for_sharing", "protected_items_reviewed", "content_coverage_reviewed", "protected_items", "items"],
  "properties": {
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_for_sharing": {"const": true},
    "protected_items_reviewed": {"const": true},
    "content_coverage_reviewed": {"const": true},
    "proposed_set_evidence": {"type": "string", "minLength": 1, "maxLength": 1200},
    "protected_items": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question", "decision", "reason"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "decision": {"enum": ["retain", "remove", "insufficient_evidence"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1200},
          "retained_alternative": {"type": "string", "minLength": 1},
          "redundancy_evidence": {"type": "string", "minLength": 1, "maxLength": 1200},
          "coverage_evidence": {"type": "string", "minLength": 1, "maxLength": 1200},
          "stability_evidence": {"type": "string", "minLength": 1, "maxLength": 1200}
        },
        "additionalProperties": false,
        "allOf": [{
          "if": {"properties": {"decision": {"const": "remove"}}},
          "then": {"required": ["retained_alternative", "redundancy_evidence", "coverage_evidence", "stability_evidence"]}
        }]
      }
    }
  },
  "additionalProperties": false
}
