{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed advanced research narrative",
  "type": "object",
  "required": ["config_sha256", "summary_sha256", "approved_for_sharing", "reference_revision", "required_references_complete", "claims"],
  "properties": {
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_for_sharing": {"const": true},
    "reference_revision": {"type": "string", "minLength": 1},
    "required_references_complete": {"const": true},
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["observation", "interpretation", "hypothesis", "next_check", "caveat", "sources"],
        "properties": {
          "observation": {"type": "string", "maxLength": 1200},
          "interpretation": {"type": "string", "maxLength": 1200},
          "hypothesis": {"type": "string", "maxLength": 1200},
          "next_check": {"type": "string", "maxLength": 1200},
          "caveat": {"type": "string", "maxLength": 1200},
          "sources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["url", "title", "body_reviewed"],
              "properties": {
                "url": {"type": "string", "pattern": "^https://"},
                "title": {"type": "string"},
                "body_reviewed": {"const": true}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
